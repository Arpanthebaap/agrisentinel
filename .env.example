# Copy this file to .env and fill in your own values.
#
# PRODUCTION / CLOUD RUN: Vertex AI (recommended, billed to GCP project,
# no daily free-tier cap). Requires `gcloud auth application-default login`
# locally, or runs automatically via Cloud Run's service account in prod.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# LOCAL DEV ONLY fallback: plain Gemini API key from https://aistudio.google.com/apikey
# Subject to the AI Studio Free Tier daily quota (~20 req/day/model) — fine
# for a couple of manual test runs, NOT for the deployed service. If
# GOOGLE_CLOUD_PROJECT is set above, this is ignored in favor of Vertex AI.
GEMINI_API_KEY=

# Optional: override the default model
AGRISENTINEL_MODEL=gemini-3.5-flash

# Optional: where the local Memory Bank JSON store lives
AGRISENTINEL_MEMORY_PATH=./data/memory_store.json
